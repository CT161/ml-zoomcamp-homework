   "source": [
    "# COLUMNS WITH LESS THAN 700 POPULATED ROWS ARE MISSING TOO MUCH DATA AND SHOULD NOT BE CONSIDERED VIABLE FEATURES\n",
    "# RECREATE LISTs OF CATEGORICAL AND NUMERIC FEATURES\n",
    "\n",
    "categorical_columns = (\n",
    "    df.select_dtypes(include=[\"object\", \"string\"])\n",
    "      .count()\n",
    "      .loc[lambda counts: counts >= 700]\n",
    "      .index\n",
    "      .tolist()\n",
    ")\n",
    "categorical_columns\n"
   ]
  },
  {
   "cell_type": "code",
