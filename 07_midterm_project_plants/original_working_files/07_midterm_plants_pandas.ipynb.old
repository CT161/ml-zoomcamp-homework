    "## METADATA - DATA DICTIONARY\n",
    "\n",
    "cn              Control number for most recent tree measurement\n",
    "prev_tre_cn1    Control number for the previous tree measurement\n",
    "spcd1           Species ID code of most recent measurement\n",
    "prev_tre_cn2    Species ID code for a previous tree measurement\n",
    "spcd2           3600439\n",
    "prev_tre_cn3     956846\n",
    "spcd3           1709900\n",
    "prev_tre_cn4     288741\n",
    "spcd4            951837\n",
    "prev_tre_cn5      23288\n",
    "spcd5            288668\n",
    "prev_tre_cn6          0\n",
    "spcd6             23288\n",
    "dif1            Difference in tree measurement between current measure and 1st previous measure\n",
    "dif2            Difference in tree measurement between 1st previous measure and 2nd previous measure\n",
    "dif3             Difference in tree measurement between 2nd previous measure and 3rd previous measure\n",
    "dif4             Difference in tree measurement between 3rd previous measure and 4th previous measure\n",
    "dif5             Difference in tree measurement between 4th previous measure and 5th previous measure\n",
    "difs             118013\n",
    "spcd_t1         3600439\n",
    "\n"
   ]
