    "                                'project_managed_by',\n",
    "                                'contact_person_s', \n",
    "                                'references' \n",
    "                            ]\n",
    "\n",
    "missing = [col for col in exclude_features_list if col not in df.columns]\n",
    "print(\"Not found:\\r\\n\", missing)\n",
    "\n",
    "df = df.drop(columns=exclude_features_list, errors='ignore')\n",
    "\n"
   ]
