   "outputs": [],
   "source": [
    "# SHOW FREQUENCY OF ALL UNIQUE VALUES PRESENT IN CATEGORICAL COLUMNS\n",
    "for c in categorical_columns:\n",
    "    print(df[c].value_counts())\n",
    "\n",
    "df[categorical_columns] = df[categorical_columns].apply(lambda col: col.str.strip())\n"
   ]
  },
  {
   "cell_type": "code",
