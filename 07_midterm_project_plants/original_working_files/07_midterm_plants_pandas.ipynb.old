    "# MID-TERM PROJECT"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "72da226a-b9bb-40b7-9059-7b29e82830c8",
   "metadata": {},
   "source": [
    "## PROJECT EXPLANATION\n",
    "`Australia is acively engaged in trying to restore indigenous plant species to their ecosystem.  \n",
    "\n",
    "This project works to predict the likelihood of second generation plants `second_generation_(y/n)` based upon the below features:\n",
    " - translocation site\n",
    " - application of treatments to support of the transplanted species\n",
    " - species\n",
    " - family\n",
    " - lifeform (tree, shrub)\n",
    " - state (the translocation destination state)\n",
    " - conservation status\n",
    " - watering\n",
    " - burnt\n",
    " - weeding\n",
    " - \n",
    " - organization managing the translocation project\n",
    "\n",
    "Silcock, Jennifer, Simmons, Laura, Monks, Leonie, Dillon, Rebecca,  and Coates, David(2021). Australian Plant Translocation Database. Australian Network for Plant Conservation, The University of Queensland. Data Collection.https://doi.org/10.14264/7e458ed\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "6bb39d89-6ead-48dd-97e1-ddf8688d80e7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# LOAD PACKAGES\n",
    "# 0.1 - DATA PREP AND MATH LIBRARIES\n",
    "import pandas       as pd\n",
    "import numpy        as np\n",
    "\n",
    "# PLOTTING\n",
    "import seaborn      as sns\n",
    "from   matplotlib                 import pyplot as plt\n",
    "%matplotlib inline \n",
    "\n",
    "\n",
    "# DECISION TREES\n",
    "from   sklearn.feature_extraction import DictVectorizer        # CONVERT DATAFRAME TO MATRIX AND APPLY ONE-HOT ENCODING\n",
    "from   sklearn.model_selection    import train_test_split      # SPLIT THE DATASET\n",
    "from   sklearn.metrics            import (\n",
    "                                    roc_auc_score,              # CLASSIFICATION ACCURACY METRIC\n",
    "                                    mean_squared_error         # REGRESSION ACCURACY METRIC\n",
    "                                )\n",
    "from   sklearn.tree               import (\n",
    "                                    DecisionTreeClassifier,     # CLASSIFICATION PREDICTIONS \n",
    "                                    DecisionTreeRegressor,      # REGRESSION PREDICTIONS\n",
    "                                    export_text                # \n",
    "                                )\n",
    "from   sklearn.ensemble           import RandomForestRegressor # ENEMBLE LEANING\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "39c31a19-e335-4a96-bfb5-85ff27551069",
   "metadata": {},
   "outputs": [],
   "source": [
    "# HELPER FUNCTIONS\n",
    "def col_value_status_table(pandas_dataframe):\n",
    "    print(\"===================================================================================================================\")\n",
    "    print(f\"  VALUES\\tMISSING\\t\\t%_MISSING\\tCOLUMN WITHIN THE PANDAS DATAFRAME\")\n",
    "    print(\"===================================================================================================================\")\n",
    "    \n",
    "    for column_name in df.columns:\n",
    "        non_missing     = pandas_dataframe[column_name].count()\n",
    "        missing         = pandas_dataframe[column_name].isna().sum()\n",
    "        total           = non_missing + missing\n",
    "        percent_missing = (missing / total * 100) if total else 0\n",
    "    \n",
    "        print(f\"  {non_missing}\\t\\t{missing}\\t\\t{percent_missing:.2f}%\\t\\t{column_name}\")\n",
    "    print(\"===================================================================================================================\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "ef422fac-ddd0-415b-bd63-1eb838bc3845",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 0.2 - GET DATA WITH PANDAS\n",
    "\n",
    "data_path  = \"C:/Users/duffl/anaconda3/_CT161_GitHub_Repos/ml-zoomcamp-homework/07_midterm_project_plants/data/Australian_plant_translocation_database_PUBLIC_2018(ALL_TRANSLOCATIONS).csv\"\n",
    "df         = pd.read_csv(data_path)\n",
    "\n",
    "# STANDARDIZE ALL COLUMN NAMES\n",
    "df.columns = (\n",
    "                df.columns.str.lower()\n",
    "                  .str.replace('%',           '_pct_', regex=False)  # REPLACE WHITESPACES AND HYPHENS WITH UNDERSCORES\n",
    "                  .str.replace(r'[ -()//]', '_',     regex=True)  # REPLACE WHITESPACES AND HYPHENS WITH UNDERSCORES\n",
    "                  .str.replace(r\"\"\"['\"]\"\"\",   '',      regex=True)  # REMOVE SINGLE QUOTES AND DOUBLE QUOTES\n",
    "                  .str.replace(r'[,;.-?]',     '',      regex=True)  # REMOVE COMMAS, PERIODS, \n",
    "             )\n",
    "\n",
    "# CREATE A LIST OF CATEGORICAL COLUMNS\n",
    "categorical_columns = df.select_dtypes(include=[\"object\", \"string\"]).columns.tolist()  \n",
    "#categorical_columns\n",
    "\n",
    "# NORMALIZE CATEGORICAL STRING VALUES - TRIM WHITESPACE, REMOVE QUOTES, LOWER CASE\n",
    "df[categorical_columns]   = df[categorical_columns].apply(\n",
    "                                lambda col: col.astype('string')\n",
    "                                               .str.replace(r\"\"\"['\"]\"\"\", '', regex=True)\n",
    "                                               .str.strip()\n",
    "                                               .str.lower()\n",
    "                            )"
   ]
  },
