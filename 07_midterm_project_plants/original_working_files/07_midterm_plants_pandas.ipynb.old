   "metadata": {},
   "outputs": [],
   "source": [
    "numerical_columns   = (\n",
    "    df.select_dtypes(include=[\"number\"])\n",
    "      .count()\n",
    "      .loc[lambda counts: counts >= 700]\n",
    "      .index\n",
    "      .tolist()\n",
    ")\n",
    "numerical_columns"
   ]
