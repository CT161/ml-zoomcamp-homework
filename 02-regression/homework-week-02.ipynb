   "source": [
    "### SETUP STUFF TO RUN BEFORE ANSWERING QUESTION 6 ###\n",
    "# HELPER FUNCTIONS\n",
    "def train_linear_regression(X,y):\n",
    "    # FUNCTION PARAMETERS\n",
    "    # X   Training dataset used to calculate feature weights\n",
    "    # y   Validation or test dataset to apply training dataset weights to\n",
    "    \n",
    "    # ADD ONES SO WEIGHTING BIAS WILL BE PRESERVED (MULTIPLCATION BY ONE)\n",
    "    \n",
    "    # 1. CREATE A VECTOR OF ONES\n",
    "    ones   = np.ones(X.shape[0])\n",
    "\n",
    "    # 2. PREPEND VECTOR OF ONES TO THE FEATURE MATRIX\n",
    "    X      = np.column_stack([ones,X])\n",
    "\n",
    "    # CREATE THE GRAM MATRIX\n",
    "    XTX    = X.T.dot(X)\n",
    "\n",
    "    XTXinv = np.linalg.inv(XTX)\n",
    "    w_full = XTXinv.dot(X.T).dot(y)\n",
    "\n",
    "    return w_full[0], w_full[1:]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "ddacdba4-58fa-40b4-911f-9b18e3937adf",
   "metadata": {},
   "outputs": [],
   "source": [
    "### SETUP STUFF TO RUN BEFORE ANSWERING QUESTION 6 ###\n",
    "# HELPER FUNCTIONS\n",
    "    \n",
    "def train_linear_regression_reg(X, y, r):\n",
    "    # FUNCTION PARAMETERS\n",
    "    # X   Training dataset used to calculate feature weights\n",
    "    # y   Validation or test dataset to apply training dataset weights to\n",
    "    # r   Regularization factor\n",
    "    \n",
    "    # ADD COLUMN OF ONES TO ALIGN FEATURE MATRIX WITH WEIGHTING BIAS INDICES\n",
    "    ones          = np.ones(X.shape[0])\n",
    "    X             = np.column_stack([ones, X])\n",
    "\n",
    "    # CALCULATE GRAM MATRIX\n",
    "    #  DEBUG NOTE: 'X.T.dot(X)' and 'X.T @ X' do the exact same math operation with 2D matrices\n",
    "    #                X shape:   ( m_rows, n_features )\n",
    "    #  DEBUG NOTE: XTX must be a (nxn) square, non-singular matrix\n",
    "    #                XTX shape: ( n_features, n_features )\n",
    "    XTX           = X.T.dot(X)     # X.T @ T      # \n",
    "    \n",
    "    # REGULARIZE THE GRAM MATRIX\n",
    "    XTX           = XTX + r * np.eye(XTX.shape[0])\n",
    "\n",
    "    # CALCULATE INVERSE OF GRAM MATRIX\n",
    "    # DEBUG NOTE: XTX_inv shape: ( n_features, n_features )\n",
    "    XTX_inv       = np.linalg.inv(XTX)\n",
    "    \n",
    "    # CALCULATE WEIGHTINGS\n",
    "    #  DEBUG NOTE: XTX must be a (nxn) square, non-singular matrix\n",
    "    #                X shape:      ( m_rows, n_features )\n",
    "    #                XTX shape:    ( n_features, n_features )\n",
    "    #                X.T shape:    ( n_features, m_rows )\n",
    "    #                y shape:      ( m_rows, )\n",
    "    #                w_full shape: ( n_features, )\n",
    "    w_full        = XTX_inv.dot(X.T).dot(y)\n",
    "\n",
    "    # SPLIT WEIGHTINGS INTO A FEATURE WEIGHTINGS AND TARGET/LABEL WEIGHTINGS VECTOR\n",
    "    return w_full[0], w_full[1:]\n"
   ]
  },
  {
   "cell_type": "code",
