    "# QUESTION 3: \n",
    "#    We need to deal with missing values for the column from Q1.\n",
    "#    We have two options: fill it with 0 or with the mean of this variable.\n",
    "#    Try both options. For each, train a linear regression model without regularization using the code from the lessons.\n",
    "#    For computing the mean, use the training only!\n",
    "#    Use the validation dataset to evaluate the models and compare the RMSE of each option.\n",
    "#    Round the RMSE scores to 3 decimal digits using round(score, 3). This keeps the imputation difference visible in this release.\n",
    "#    Which option gives better RMSE?\n",
    "#    Options:\n",
    "#    \n",
    "#    With 0\n",
    "#    With mean\n",
    "#    Both are equally good\n",
    "\n",
    "def rmse(y, y_pred):\n",
    "    # FUNCTION PARAMETERS\n",
    "    # y       Mattix of actual values from target / labels dataset \n",
    "    # y_pred  Matrix of prediccted values for target / labels\n",
    "\n",
    "    se             = (y - y_pred) ** 2  # standard error\n",
    "    mse            = se.mean()          # mean of squared error values\n",
    "    return np.sqrt(mse)                 # square root of mean squared error\n",
    "    \n",
    "def prepare_X(df, base_features):\n",
    "    df_num = df[base_features]\n",
    "\n",
    "    # CREATE A COPY OF THE 'df' PARAMETER\n",
    "    #   THIS PROTECTS THE ORIGINAL 'df' DATAFRAME FROM BEING MODIFIED IN A WAY THAT CANNOT BE UNDONE\n",
    "    #   THE FUNCTION WILL MODIFY THE CONTENT OF THE COPY OF THE 'df', NOT THE SOURCE 'df'\n",
    "    df_copy        = df.copy()\n",
    "    features       = base.copy()\n",
    "    \n",
    "    # CREATE A NEW df CONTAINING ONLY COLUMNS WITH NUMERIC VALUES\n",
    "    df_num    = df_copy[features]\n",
    "\n",
    "    # FILL MISSING VALUES WITH ZEROS\n",
    "    # df_num    = df_num.fillna(0)\n",
    "\n",
    "    # CREATE A numpy ARRAY FROM THE PANDAS DATAFRAME\n",
    "    X         = df_num.values\n",
    "\n",
    "    # RETURN numpy ARRAY\n",
    "    return X\n",
    "\n",
    "\n",
    "# CREATE A NEW FUNCTION TO CALCULATE THE FEATURE WEIGHTS\n",
    "def train_linear_regression(X,y):\n",
    "    # FUNCTION PARAMETERS\n",
    "    # X   Training dataset used to calculate feature weights\n",
    "    # y   Validation or test dataset to apply training dataset weights to\n",
    "    \n",
    "    # ADD ONES SO WEIGHTING BIAS WILL BE PRESERVED (MULTIPLCATION BY ONE)\n",
    "    \n",
    "    # 1. CREATE A VECTOR OF ONES\n",
    "    ones   = np.ones(X.shape[0])\n",
    "\n",
    "    # 2. PREPEND VECTOR OF ONES TO THE FEATURE MATRIX\n",
    "    X      = np.column_stack([ones,X])\n",
    "\n",
    "    # CREATE THE GRAM MATRIX\n",
    "    XTX    = X.T.dot(X)\n",
    "\n",
    "    XTXinv = np.linalg.inv(XTX)\n",
    "    w_full = XTXinv.dot(X.T).dot(y)\n",
    "\n",
    "    return w_full[0], w_full[1:]\n",
    "    \n",
    "# 1. calculate horsepower mean \n",
    "mean_val                    = df_train['horsepower'].mean()\n",
    "\n",
    "# 2. Prepare ML datasets\n",
    "X_train_zeros               = df_train.copy()\n",
    "X_train_zeros['horsepower'] = X_train_zeros['horsepower'].fillna(0) #.values\n",
    "\n",
    "X_train_mean                = df_train.copy()\n",
    "X_train_mean['horsepower']  = X_train_mean['horsepower'].fillna(mean_val) #.values\n",
    "\n",
    "X_val_zeros                 = df_val.copy()\n",
    "X_val_zeros['horsepower']   = X_val_zeros['horsepower'].fillna(0) #.values\n",
    "\n",
    "X_val_mean                  = df_val.copy()\n",
    "X_val_mean['horsepower']    = X_val_mean['horsepower'].fillna(mean_val) #.values\n",
    "\n",
    "X_test_zeros                = df_test.copy()\n",
    "X_test_zeros['horsepower']  = X_test_zeros['horsepower'].fillna(0) #.values\n",
    "\n",
    "X_test_mean                 = df_test.copy()\n",
    "X_test_mean['horsepower']   = X_test_mean['horsepower'].fillna(mean_val) #.values\n",
    "\n",
    "# 3. Convert DataFrames to 2D NumPy Feature Matrices\n",
    "X_train_zeros     = prepare_X(X_train_zeros, base)\n",
    "X_train_mean      = prepare_X(X_train_mean,  base)\n",
    "\n",
    "X_val_zeros       = prepare_X(X_val_zeros, base)\n",
    "X_val_mean        = prepare_X(X_val_mean,  base)\n",
    "\n",
    "# 4. Train Models\n",
    "#   r                regularization multiplier\n",
    "#   X_train          feature matrix\n",
    "#   y_train          target / label matrix\n",
    "#   w0               weighting bias\n",
    "#   w                feature Weighting matrix\n",
    "r = 0.001\n",
    "w0_zeros, w_zeros = train_linear_regression(X_train_zeros, y_train)\n",
    "w0_mean,  w_mean  = train_linear_regression(X_train_mean,  y_train)\n",
    "\n",
    "# 5. Predict on Validation Data\n",
    "y_pred_zeros      = w0_zeros + X_val_zeros.dot(w_zeros)\n",
    "y_pred_mean       = w0_mean  + X_val_mean.dot(w_mean)\n",
    "\n",
    "# 6. Evaluate RMSE\n",
    "score_zeros       = rmse(y_val, y_pred_zeros)\n",
    "score_mean        = rmse(y_val, y_pred_mean)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "print(f\"ANSWER\\r\\n\\tRMSE Score (zeros) in log:\\t\\t{score_zeros:.4f}\")\n",
    "print(f\"\\tRMSE Score (Mean)  in log:\\t\\t{score_mean:.4f}\")\n",
    "\n",
    "# Convert predicted and actual log values back to original MPG\n",
    "y_pred_zeros_mpg = np.expm1(y_pred_zeros)\n",
    "y_test_zeros_mpg = np.expm1(y_test)\n",
    "y_pred_mean_mpg  = np.expm1(y_pred_mean)\n",
    "y_test_mean_mpg  = np.expm1(y_test)\n",
    "\n",
    "# Calculate RMSE on the original scale\n",
    "score_zeros_mpg = rmse(y_test_zeros_mpg, y_pred_zeros_mpg)\n",
    "score_mean_mpg  = rmse(y_test_mean_mpg,  y_pred_mean_mpg)\n",
    "\n",
    "print(f\" \\tRMSE Score (zeros) in original MPG: \\t{score_zeros_mpg:.4f}\")\n",
    "print(f\" \\tRMSE Score (mean)  in original MPG: \\t{score_mean_mpg:.4f}\")\n",
    "print(\"Filling missing values with zeros is marginally better, though the results are almost the same as filling with the mean\")\n",
