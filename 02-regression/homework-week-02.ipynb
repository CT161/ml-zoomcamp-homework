    "# Question 4¶\n",
    "# Now let's train a regularized linear regression.\n",
    "# For this question, fill the NAs with 0.\n",
    "# Try different values of r from this list: [0, 0.01, 0.1, 1, 5, 10, 100].\n",
    "# Use RMSE to evaluate the model on the validation dataset.\n",
    "# Round the RMSE scores to 4 decimal digits. This keeps the small but real regularization differences visible instead of turning several choices into a tie.\n",
    "# Which r gives the best RMSE?\n",
    "# If multiple options give the same best RMSE, select the smallest r.\n",
    "# \n",
    "# Options:\n",
    "# \n",
    "#   0\n",
    "#   0.01\n",
    "#   0.1\n",
    "#   1\n",
    "#   5\n",
    "#   10\n",
    "#   100\n",
    "\n",
    "\n",
    "# SELECT NUMERIC FEATURE COLUMNS\n",
    "base = [\n",
    "        'engine_displacement',\n",
    "        'horsepower',\n",
    "        'vehicle_weight',\n",
    "        'model_year'\n",
    "       ]\n",
    "\n",
    "# CREATE A NEW DATAFRAME WITH NUMERIC COLUMNS\n",
    "df = df[base + ['fuel_efficiency_mpg']]\n",
    "\n",
    "def prepare_X(df, base_features):\n",
    "    df_num    = df[base_features]\n",
    "\n",
    "    # CREATE A COPY OF THE 'df' PARAMETER\n",
    "    #   THIS PROTECTS THE ORIGINAL 'df' DATAFRAME FROM BEING MODIFIED IN A WAY THAT CANNOT BE UNDONE\n",
    "    #   THE FUNCTION WILL MODIFY THE CONTENT OF THE COPY OF THE 'df', NOT THE SOURCE 'df'\n",
    "    df_copy   = df.copy()\n",
    "    features  = base_features.copy()\n",
    "    \n",
    "    # CREATE A NEW df CONTAINING ONLY COLUMNS WITH NUMERIC VALUES\n",
    "    df_num    = df_copy[features]\n",
    "\n",
    "    # FILL MISSING VALUES WITH ZEROS\n",
    "    df_num    = df_num.fillna(0)\n",
    "\n",
    "    # CREATE A numpy ARRAY FROM THE PANDAS DATAFRAME\n",
    "    X         = df_num.values\n",
    "\n",
    "    # RETURN numpy ARRAY\n",
    "    return X\n",
    "\n",
    "def train_linear_regression_reg(X, y, r):\n",
    "    # FUNCTION PARAMETERS\n",
    "    # X   Training dataset used to calculate feature weights\n",
    "    # y   Validation or test dataset to apply training dataset weights to\n",
    "    # r   Regularization factor\n",
    "    \n",
    "    # ADD COLUMN OF ONES TO ALIGN FEATURE MATRIX WITH WEIGHTING BIAS INDICES\n",
    "    ones          = np.ones(X.shape[0])\n",
    "    X             = np.column_stack([ones, X])\n",
    "\n",
    "    # CALCULATE GRAM MATRIX\n",
    "    #  DEBUG NOTE: 'X.T.dot(X)' and 'X.T @ X' do the exact same math operation with 2D matrices\n",
    "    #                X shape:   ( m_rows, n_features )\n",
    "    #  DEBUG NOTE: XTX must be a (nxn) square, non-singular matrix\n",
    "    #                XTX shape: ( n_features, n_features )\n",
    "    XTX           = X.T.dot(X)     # X.T @ T      # \n",
    "    \n",
    "    # REGULARIZE THE GRAM MATRIX\n",
    "    XTX           = XTX + r * np.eye(XTX.shape[0])\n",
    "\n",
    "    # CALCULATE INVERSE OF GRAM MATRIX\n",
    "    # DEBUG NOTE: XTX_inv shape: ( n_features, n_features )\n",
    "    XTX_inv       = np.linalg.inv(XTX)\n",
    "    \n",
    "    # DEBUG\n",
    "    # print(\"==== train_linear_regression_reg =====================================\")\n",
    "    # print(f\"               | VALUE                 | SHAPE\")\n",
    "    # print(\"======================================================================\")\n",
    "    # print(f\"X (train shape)|                       | {X.shape}\")\n",
    "    # print(f\"y (pred shape) |                       | {y.shape}\")\n",
    "    # print(\"======================================================================\")\n",
    "    # print(f\"w0 (original)  | {w0}   | {w0.shape}\")\n",
    "    # print(f\"w  (original)  |                       | {w.shape}\")\n",
    "    # print(\"======================================================================\")\n",
    "    # print(f\"XTX shape      |                       | {XTX.shape}\")\n",
    "    # print(f\"X.T.shape      |                       | {X.T.shape}\")\n",
    "    # print(\"======================================================================\")\n",
    "    \n",
    "    # CALCULATE WEIGHTINGS\n",
    "    #  DEBUG NOTE: XTX must be a (nxn) square, non-singular matrix\n",
    "    #                X shape:      ( m_rows, n_features )\n",
    "    #                XTX shape:    ( n_features, n_features )\n",
    "    #                X.T shape:    ( n_features, m_rows )\n",
    "    #                y shape:      ( m_rows, )\n",
    "    #                w_full shape: ( n_features, )\n",
    "    w_full        = XTX_inv.dot(X.T).dot(y)\n",
    "\n",
    "    # SPLIT WEIGHTINGS INTO A FEATURE WEIGHTINGS AND TARGET/LABEL WEIGHTINGS VECTOR\n",
    "    return w_full[0], w_full[1:]\n",
    "\n",
    "def rmse(y, y_pred):\n",
    "    # FUNCTION PARAMETERS\n",
    "    # y       Mattix of actual values from target / labels dataset \n",
    "    # y_pred  Matrix of prediccted values for target / labels\n",
    "\n",
    "    se             = (y - y_pred) ** 2  # standard error\n",
    "    mse            = se.mean()          # mean of squared error values\n",
    "    return np.sqrt(mse)                 # square root of mean squared error\n",
    "\n",
    "\n",
    "# 1. CALCULATE HORSEPOWER MEAN \n",
    "mean_val                    = df_train['horsepower'].mean()\n",
    "\n",
    "# 2. CREATE ML DATASETS\n",
    "X_train_zeros               = df_train.copy()\n",
    "#X_train_zeros['horsepower'] = X_train_zeros['horsepower'].fillna(0) #.values\n",
    "\n",
    "# X_train_mean                = df_train.copy()\n",
    "# X_train_mean['horsepower']  = X_train_mean['horsepower'].fillna(mean_val) #.values\n",
    "\n",
    "X_val_zeros                 = df_val.copy()\n",
    "#X_val_zeros['horsepower']   = X_val_zeros['horsepower'].fillna(0) #.values\n",
    "\n",
    "# X_val_mean                  = df_val.copy()\n",
    "# X_val_mean['horsepower']    = X_val_mean['horsepower'].fillna(mean_val) #.values\n",
    "\n",
    "X_test_zeros                = df_test.copy()\n",
    "#X_test_zeros['horsepower']  = X_test_zeros['horsepower'].fillna(0) #.values\n",
    "\n",
    "# X_test_mean                 = df_test.copy()\n",
    "# X_test_mean['horsepower']   = X_test_mean['horsepower'].fillna(mean_val) #.values\n",
    "\n",
    "# 3. CONVERT PANDAS DATAFRAMES TO NUMPY FEATURE MATRICES\n",
    "X_train_zeros     = prepare_X(X_train_zeros, base)\n",
    "# X_train_mean      = prepare_X(X_train_mean,  base)\n",
    "\n",
    "X_val_zeros       = prepare_X(X_val_zeros, base)\n",
    "# X_val_mean        = prepare_X(X_val_mean,  base)\n",
    "\n",
    "# LIST OF REGULARIZATION VALUES TO TEST\n",
    "reg_list        = [0, 0.01, 0.1, 1, 5, 10, 100]\n",
    "   \n",
    "r_min = None\n",
    "best_score = float(\"inf\")\n",
    "\n",
    "# r_min_score_mpg = 9999999999\n",
    "# r_min_score_log = 9999999999\n",
    "\n",
    "print(\"======================================================================\")\n",
    "print(\"==\\tR-VALUE\\t\\tRMSE (LOG) SCORE                               ==\")\n",
    "print(\"======================================================================\")\n",
    "for r in reg_list:    \n",
    "    # 4. Train Models\n",
    "    #   r                regularization multiplier\n",
    "    #   X_train          feature matrix\n",
    "    #   y_train          target / label matrix\n",
    "    #   w0               weighting bias\n",
    "    #   w                feature Weighting matrix\n",
    "\n",
    "    w0_zeros, w_zeros = train_linear_regression_reg(X_train_zeros, y_train, r)\n",
    "    # w0_mean,  w_mean  = train_linear_regression_reg(X_train_mean,  y_train, r)\n",
    "    \n",
    "    # 5. Predict on Validation Data\n",
    "    y_pred_log      = w0_zeros + X_val_zeros.dot(w_zeros)\n",
    "    # y_pred_mean       = w0_mean  + X_val_mean.dot(w_mean)\n",
    "\n",
    "    # 6. Evaluate RMSE\n",
    "    score_log       = rmse(y_val, y_pred_log)\n",
    "    # score_mean        = rmse(y_val, y_pred_mean)\n",
    "\n",
    "    if score_log < best_score :\n",
    "        best_score = score_log\n",
    "        r_min      = r  \n",
    "\n",
    "    # Convert predicted and actual log values back to original MPG\n",
    "    y_pred_mpg     = np.expm1(y_pred_log)\n",
    "    y_test_mpg     = np.expm1(y_test)\n",
    "\n",
    "    \n",
    "    print(f\"\\t{r}\\t\\t{score_log:.4f}\")\n",
    "    #print(f\"RMSE (Filled with Zeros, r = {r}): {score_zeros:.4f}\")\n",
    "    # print(f\"RMSE (Filled with Mean,  r = {r}): {score_mean:.4f}\")\n",
    "print(\"======================================================================\")\n",
    "print(f\"ANSWER: \\r\\n\\tBest regularization value (log): \\t{r_min}\\r\\n\\tBest RMSE Score: \\t\\t\\t{best_score:.4f}\")\n",
