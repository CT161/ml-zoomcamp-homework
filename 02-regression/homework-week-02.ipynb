    "### SETUP STUFF TO RUN BEFORE ANSWERING QUESTION 6 ###\n",
    "# HELPER FUNCTIONS\n",
    "def prepare_X(df_in, base_features):\n",
    "    df_num = df_in[base_features].copy()\n",
    "    df_num = df_num.fillna(0)  # Fill missing values with 0\n",
    "    return df_num.values"
   ]
