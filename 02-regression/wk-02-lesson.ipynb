    "# LESSON 2.6 - LINEAR REGRESSION: VECTOR FORM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "62ac4dac",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Convert prediction formula to python code ###\n",
    "# # prediction formula (simple)\n",
    "#       g(xi) = W0 + (W1)(xi1) + (W2)(xi2) + (W3)(xi3)\n",
    "#     prediction formula (symbolic)           \n",
    "#       g(xi) = W0 + Σ(Wj)(xij) # where j=0 and stops at 2 (n-1)\n",
    "# \n",
    "# Since Wj and xij are both matrices, we recognize this as a numpy dot product\n",
    "#\n",
    "# Re-write the equation\n",
    "#       g(xi) = W0 + (xTi )(wj)\n",
    "#         # W0  = weighting biaas\n",
    "#         # xTi = feature matrix x for row i\n",
    "#         # T   > T indicates a transformation operation\n",
    "#         #       (specifically the transformed version of matrix x)\n",
    "#         # w   = weights vector\n",
    "#         # wj  = the weighting factor applicable to element j\n",
    "\n",
    "#  To implement this function we need to write some functions\n",
    "def dot(xi,w):\n",
    "    n    = len(xi)\n",
    "    res  = 0.0  # result\n",
    "\n",
    "    for j in range(n):\n",
    "        res = res + xi[j] * w[j]\n",
    "\n",
    "    return res\n",
    "\n",
    "def linear_regression(xi):\n",
    "    return w0 + dot(xi,w)\n",
    "\n",
    "# We can simplify the calculation if we shift \n",
    "# 'w0' so that it becomes the first member of the \n",
    "# weighting vector 'w'\n",
    "#   W  = [w0,w1,w2,w3,...wn]\n",
    "# which beter aligns with the feature vector\n",
    "#   xi = [x0,x1,x2,x3,...xn]\n",
    "# when you add a value to a list, python will prepend the value as a list element\n",
    "w_new = [w0] + w  \n"
   ]
  },
