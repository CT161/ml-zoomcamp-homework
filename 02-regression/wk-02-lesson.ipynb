     "text": [
      "THE RMSE IMPROVED WHEN THE VALIDATION DATASET WAS ENHANCED WITH AN 'age' FEATURE\n",
      "  rmse_train:        0.7554192603920132\n",
      "  rmse_val:          0.7616530991301587\n",
      "  rmse_val_1:        0.5172055461058314\n"
     ]
    }
   ],
   "source": [
    "######################################################################################\n",
