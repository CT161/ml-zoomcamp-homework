   "source": [
    "## EXPLANATION  \n",
    "#   Feature Engineering did not work as expected because two columns contained the same values\n",
    "#   This 'duplication' causes the method we used to create the inverse of the feature matrix to fail.\n",
    "#    For reference, we used this formula\n",
    "#\n",
    "#       w = (XᵀX)⁻¹ Xᵀ y\n",
    "#\n",
    "#    The problem we have is with this part: we need to take the inverse of the Gram matrix XᵀX, and sometimes this inverse doesn't exist. \n",
    "#    \n",
    "#  We can demonstrate the issue here\n",
    "#\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "14a252a2-520a-4c1f-8248-b86598ea9ee6",
   "metadata": {},
   "outputs": [],
   "source": [
    "####################################################################################\n",
    "# STUFF TO INITIALIZE BEFORE THE CODE IN THIS LESSON WILL RUN\n",
    "####################################################################################\n",
    "# LOAD PACKAGES\n",
    "import numpy  as np\n",
    "import pandas as pd\n",
    "\n",
    "# GET DATA\n",
    "url = \"https://raw.githubusercontent.com/alexeygrigorev/mlbookcamp-code/master/chapter-02-car-price/data.csv\"\n",
    "df = pd.read_csv(url)\n",
    "\n",
    "# PREPARE DATA\n",
    "#standardize column names\n",
    "df.columns = df.columns.str.lower().str.replace(' ', '_')\n",
    "\n",
    "# create a python list containing all the string column names\n",
    "strings = list(df.dtypes[df.dtypes == 'str'].index)\n",
    "\n",
    "# standardize matrix string values in every string element of the dataframe\n",
    "for col in strings:\n",
    "    df[col] = df[col].str.lower().str.replace(' ', '_')\n",
    "\n",
    "# DEFINE 'base' LIST OF NUMERIC FEATURES IN TRAINING DATASET\n",
    "base = ['engine_hp', 'engine_cylinders', 'highway_mpg',\n",
    "        'city_mpg', 'popularity']\n",
    "\n",
    "X_val = df_val[base].fillna(0).values\n",
    "\n",
    "# IMPROVE THE 'prepare_X' FUNCTION TO DYNAMICALLY SPLIT CATEGORICAL VARIABLES INTO DISCRETE COLUMNS\n",
    "def prepare_X(df):\n",
    "    # CREATE A COPY OF THE 'df' PARAMETER\n",
    "    #   THIS PROTECTS THE ORIGINAL 'df' DATAFRAME FROM BEING MODIFIED IN A WAY THAT CANNOT BE UNDONE\n",
    "    #   THE FUNCTION WILL MODIFY THE CONTENT OF THE COPY OF THE 'df', NOT THE SOURCE 'df'\n",
    "    df_copy        = df.copy()\n",
    "    features  = base.copy()\n",
    "\n",
    "    # DEBUG\n",
    "    print()\n",
    "    print(f\"    len(features) (0):     {len(features)}\")\n",
    "    \n",
    "    # ADD A NEW 'age' FEATURE VALUES TO THE 'df'\n",
    "    df_copy['age'] = max(df_val.year)  - df_copy.year\n",
    "    # ADD A NEW 'age' FEATURE TO THE END OF THE FEATURE LABEL MATRIX ([base])\n",
    "    features.append('age')\n",
    "\n",
    "    # DEBUG\n",
    "    print(f\"    len(features) (age):   {len(features)}\")\n",
    " \n",
    "    # CONVERT THE 'number_of_doors' CATEGORICAL COLUMN INTO BINARY COLUMNS\n",
    "    for v in [2, 3, 4]:\n",
    "        df_copy['num_doors_%s' % v] = (df_copy.number_of_doors == v).astype('int')\n",
    "        features.append('num_doors_%s' % v)\n",
    "\n",
    "    # DEBUG\n",
    "    print(f\"    len(features) (doors): {len(features)}\")\n",
    "    \n",
    " #   # ADD COLUMNS FOR THE 5 MOST POPULAR CAR makes\n",
    " #   for v in makes:\n",
    " #       df['make_%s' % v] = (df.make == v).astype('int')\n",
    " #       features.append('make_%s' % v)\n",
    "\n",
    "    # MANUALLY CREATE LIST OF CATEGORICAL VARIABLES\n",
    "    categorical_variables = [\n",
    "        'make', \n",
    "        'engine_fuel_type', \n",
    "        'transmission_type', \n",
    "        'driven_wheels',\n",
    "        'market_category', \n",
    "        'vehicle_size', \n",
    "        'vehicle_style'\n",
    "    ]\n",
    "\n",
    "    # INITIALIZE A DICTIONARY\n",
    "    categories = {}\n",
    "\n",
    "    # POPULATE THE 'categories' LIST\n",
    "    for c in categorical_variables:\n",
    "        categories[c] = list(df_train[c].value_counts().head().index)\n",
    "\n",
    "    # ITERATE THROUGH THE LIST WITH A SUBLOOP FOR EACH VALUE WITHIN EACH CATEGORY\n",
    "    for c, values in categories.items():\n",
    "        for v in values:\n",
    "            df_copy['%s_%s' % (c, v)] = (df_copy[c] == v).astype('int')\n",
    "            features.append('%s_%s' % (c, v))\n",
    "            # print(f\"  {'%s_%s' % (c, v)}\")\n",
    "\n",
    "    # DEBUG STUFF\n",
    "    print(f\"    len(features) (list):  {len(features)}\")\n",
    "    \n",
    "    # CREATE A NEW df CONTAINING ONLY COLUMNS WITH NUMERIC VALueS\n",
    "    df_num    = df_copy[features]\n",
    "\n",
    "    # FILL MISSING VALUES WITH ZEROS\n",
    "    df_num    = df_num.fillna(0)\n",
    "\n",
    "    # CREATE A numpy ARRAY FROM THE PANDAS DATAFRAME\n",
    "    X         = df_num.values\n",
    "\n",
    "    # RETURN numpy ARRAY\n",
    "    return X\n",
    "\n",
    "# CREATE RMSE FUNCTION\n",
    "def rmse(y, y_pred):\n",
    "    se     = (y - y_pred) ** 2\n",
    "    mse    = se.mean()\n",
    "    return np.sqrt(mse)"
   ]
