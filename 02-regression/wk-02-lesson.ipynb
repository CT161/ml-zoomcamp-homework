    "    [413, 11, 86],\n",
    "    [38,  54, 185],\n",
    "    [142, 25, 431],\n",
    "    [453, 31, 86],\n",
    "]\n",
    "X = np.array(X)\n",
    "\n",
    "\n",
    "ones = np.ones(X.shape[0])\n",
    "# print(ones.round(1))\n",
    "\n",
    "X = np.column_stack([ones, X])\n",
    "\n",
    "with np.printoptions(suppress=True, precision=1):\n",
    "    print(X)"
   ]
  },
