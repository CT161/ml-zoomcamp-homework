    "# PROBLEM:  This weighting matrix does not have a first column of ones\n",
    "# SOLUTION: Create a matrix of onces and join it to the feature matrix\n",
    "#             np.column_stack([list of arrays to combine])\n",
    "\n",
    "# RESET ORIGINAL X VALUES\n",
    "X = [\n",
    "    [148, 24, 1385],\n",
    "    [132, 25, 2031],\n",
    "    [453, 11, 86],\n",
