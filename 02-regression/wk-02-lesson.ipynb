     ]
    }
   ],
   "source": [
    "######################################################################################\n",
    "#### DATA SET VALIDATION CODE BLOCK ##################################################\n",
    "######################################################################################\n",
    "\n",
    "# CREATE WEIGHTS FROM TRAINING DATA\n",
    "X_train   = prepare_X(df_train)\n",
    "w0, w     = train_linear_regression(X_train, y_train)\n",
