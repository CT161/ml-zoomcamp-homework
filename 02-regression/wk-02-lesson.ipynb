   ],
   "source": [
    "# ROOT MEAN SQUARED (TRAINING DATASET) ERROR\n",
    "# Calculate error as the difference between predicted and actual\n",
    "# Square this calculated error to \"punish\" greater differences\n",
    "# Sum  '\n",
    "def rmse(y, y_pred):\n",
    "    se     = (y - y_pred) ** 2\n",
    "    mse    = se.mean()\n",
    "    return np.sqrt(mse)\n",
    "\n",
    "rmse_train = rmse(y_train, y_pred)\n",
    "print(f\"RSME (train):                {rmse_train}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1d3c1b7a",
   "metadata": {},
   "source": [
    "# LESSON 2.10 - COMPUTING RMSE ON VALIDATION"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 54,
   "id": "588ec52f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# FEATURE SELECTION: MAKE A LIST OF COLUMNS WITH NUMERIC VALUES\n",
    "# (THIS IS EXACTLY THE SAME base CREATED DURING df.train operations above\n",
    "base = ['engine_hp', 'engine_cylinders', 'highway_mpg',\n",
    "        'city_mpg', 'popularity']\n",
    "\n",
    "X_val = df_val[base].fillna(0).values"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "c09e21cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# PREPARE X \n",
    "# 1. SELECT ONLY COLUMNS WITH NUMERIC VALUES [base]\n",
    "# 2. CREATE A NEW DF TO HOLD THESE COLUMNS (df_num)\n",
    "# 3. FILL MISSING VALUES WITH ZEROS\n",
    "# 4. RETURN THE NEW DATAFRAME (MATRIX)\n",
    "\n",
    "def prepare_X(df):\n",
    "    df_num = df[base]\n",
    "    df_num = df_num.fillna(0)\n",
    "    X = df_num.values\n",
    "    return X"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 56,
   "id": "92014f4b",
