   "id": "2e45a2d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ONE COLUMN OF CATEGORICAL DATA WILL BECOME MULTIPLE COLUMNS OF BINARY DATA (1 OR 0)\n",
    "#  IN OUR DATASET WE HAVE A COLUMN FOR THE NUMBER OF DOORS ON THE CAR\n",
    "#  UNIQUE VALUES IN THIS COLUMN ARE 2, 3 AND 4\n",
    "#  WE WILL WRITE A LOOP TO CREATE A NEW 'df' COLUMN FOR EACH OF THESE VALUES\n",
    "#  SINCE THE FUNCTION WILL RETURN BOOLEAN TRUE/FALSE RESPONSES, WE NEED TO CAST THESE BOOLEAN VALUES INTO INTEGERS\n",
    "\n",
    "# v = UNIQUE COUNTS OF DOORS\n",
    "# %s = A STRING VARIABLE WHERE (%) THE %s STRING VALUES COME FROM ITERATING THROUGH THE LIST 'v'\n",
    "#   for v in [2, 3, 4]:\n",
    "#     df_train['num_doors_%s' % v] = (df_train.number_of_doors == v).astype('int')\n",
    "\n",
    "# REMINDER OF WHAT THE [base] LIST INCLUDES\n",
    "# base = ['engine_hp', 'engine_cylinders', 'highway_mpg',\n",
    "#        'city_mpg', 'popularity']\n",
    "\n",
    "# IMPROVE THE 'prepare_X' FUNCTION \n",
    "def prepare_X(df):\n",
    "    # CREATE A COPY OF THE 'df' PARAMETER\n",
    "    #   THIS PROTECTS THE ORIGINAL 'df' DATAFRAME FROM BEING MODIFIED IN A WAY THAT CANNOT BE UNDONE\n",
    "    #   THE FUNCTION WILL MODIFY THE CONTENT OF THE COPY OF THE 'df', NOT THE SOURCE 'df'\n",
    "    df        = df.copy()\n",
    "  \n",
    "    features  = base.copy()\n",
    "    \n",
    "    # ADD A NEW 'age' FEATURE VALUES TO THE 'df'\n",
    "    df['age'] = max(df_val.year)  - df.year\n",
    "    \n",
    "    # ADD A NEW 'age' FEATURE TO THE END OF THE FEATURE LABEL MATRIX ([base])\n",
    "    features.append('age')\n",
    "\n",
    "    # CONVERT THE 'number_of_doors' CATEGORICAL COLUMN INTO BINARY COLUMNS\n",
    "    for v in [2, 3, 4]:\n",
    "        df['num_doors_%s' % v] = (df.number_of_doors == v).astype('int')\n",
    "        features.append('num_doors_%s' % v)\n",
    "\n",
    "    # CREATE A NEW df CONTAINING ONLY COLUMNS WITH NUMERIC VALueS\n",
    "    df_num    = df[features]\n",
    "\n",
    "    # FILL MISSING VALUES WITH ZEROS\n",
    "    df_num    = df_num.fillna(0)\n",
    "\n",
    "    # CREATE A numpy ARRAY FROM THE PANDAS DATAFRAME\n",
    "    X         = df_num.values\n",
    "\n",
    "    # RETURN numpy ARRAY\n",
    "    return X"
   ]
