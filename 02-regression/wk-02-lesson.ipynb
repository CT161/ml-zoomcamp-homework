   ],
   "source": [
    "# STEP 1: REGULARIZE MATRIX 'XTX'\n",
    "#   INITIALIZE XTX AS A LIST\n",
    "XTX = [\n",
    "    [1, 2, 2],\n",
    "    [2, 1, 1.0000001],\n",
    "    [2, 1.0000001, 1],\n",
    "]\n",
    "# CONVERT TO numpy ARRAY\n",
    "XTX = np.array(XTX)\n",
    "\n",
    "# ADD NOISE TO XTX\n",
    "XTX = XTX + (0.01 * np.eye(3))\n",
    "\n",
    "# GRAM MATRIX\n",
