# SET PYTHON VERSION
FROM python:3.12.1-slim-bookworm

# INSTALL PACKAGES
#   BASIC WAY OF INSTALLING 'uv'
#   RUN pip install uv 
#   'uv' DEVELOPMENT TEAM RECOMMENDED WAY OF INSTALLING 'uv' INTO DOCKER
#      THIS COPY APPROACH USES FEWER TEMP FILES AND IS FASTER THAN 'pip'
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# CREATE WORKING DIRECTORY
WORKDIR /app

# FILES IN THE bin DIRECTORY SHOULD BE GLOBALLY AVAILABLE
#  DO THIS BY SETTING A PATH VARIABLE
ENV PATH="/app/.venv/bin:PATH"

# COPY ENVIRONMENT CONFIGURATION SETUP INSTRUCTIONS
#   FIRST PARAMETERS IDENTIFY FILES TO COPY
#   LAST PARAM INDICATES WHERE FILES SHOULD BE DROPPED
#     "./" MEANS THE CURRENT DIRECTORY
#     NOTE 1: LINE 8 SETS THE CURRENT DIRECTORY TO "/app"
#     NOTE 2: DO NOT USE COMMA SEPARATORS
COPY ".python-version" "pyproject.toml" "uv.lock" "./"

# USE THE EXACT PACKAGES AND LIBRARIES SPECIFIED IN THE 
#   'uv.lock' FILE
RUN uv sync --locked

# COPY THE APPLICATION FILES
#  IF ALL APPLICATION FILES WERE IN A DIRECTORY,YOU COULD COPY THE DIRECTORY
#     NOTE: DO NOT USE COMMA SEPARATORS
COPY "predict.py" "model.bin" "./"

# MAKE THE PORT TO THIS VIRTUAL ENVIRONMENT ACCESSIBLE TO EXTERNAL APPS 
EXPOSE 9696

# TELL DOCKER WHICH THINGS CAN RUN
# ENTRYPOINT ["uv", "run", "uvicorn", "prediction:app", "-host", "0.0.0.0", "--port", "9696"]
#     ENTRYPOINT WAS SIMPLIFIED TO DROP THE 'uv' AND 'run' COMMANDS BY SETTING A PATH VARIABLE
ENTRYPOINT ["uvicorn", "prediction:app", "-host", "0.0.0.0", "--port", "9696"]
#     NOTE: THESE ARE THE EXACT SAME PARAMETERS YOU WOULD ENTER TO LAUNCH THE 
#           APPLICATION FROM THE COMMAND PROMPT IN THE DEV ENVIRONMENT
#           "--reload" HAS BEEN OMITTED FROM THIS LIST SINCE WE KNOW THE APP
#           FILES WILL NOT CHANGE


# TO BUILD THIS DOCKER CONTAINER...
#   1. GO TO A TERMINAL
#   2. RUN THE FOLLOWING COMMAND
#      docker build -t churn-prediction .
#        -t churn-prediction   CREATES A TAG FOR THIS CONTAINER
#        .                     INDICATES THE CURRENT DIRECTORY


# TO RUN THIS DOCKER CONTAINER...
#   1. GO TO A TERMINAL
#   2. RUN THE FOLLOWING COMMAND
#      docker run -t --rm -p 9696:9696 churn-prediction
#        -it                   RUN IN INTERACTIVE MODE
#                                MEANING THAT CTRL + C WILL STOP THE CONTAININER
#        --rm                  DELETE THE CONTAINER WHEN IT STOPS RUNNING
#        -p 9696:9696          PORT MAPPING  INTERNAL CONTAINER PORT 9696
#                                            ACCESS POINT TO THE CONTAINER IS 
#                                            THROUGH PORT 9696
#        churn-prediction      NAME OF IMAGE TO RUN